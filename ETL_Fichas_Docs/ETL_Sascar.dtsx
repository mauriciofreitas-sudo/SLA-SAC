                        <arrayElement
                          dataType="System.String"><![CDATA[#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
using System.Net;
using System.IO;
using System.Xml;
#endregion

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void CreateNewOutputRows()
    {
        ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12;

        // L� o ID do ve�culo da vari�vel do SSIS, que � populada pelo Loop
        int vehicleId = Variables.CurrentVehicleID;

        string url = "https://sasintegra.sascar.com.br/SasIntegra/SasIntegraWSService";
        string dataFim = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
        string dataInicio = DateTime.Now.AddHours(-48).ToString("yyyy-MM-dd HH:mm:ss");

        // Corpo da requisi��o para o m�todo obterPacotePosicaoMotoristaHistorico
        // As credenciais foram preenchidas nos par�metros da fun��o String.Format abaixo
        string soapRequestXml = String.Format(@"
        <soapenv:Envelope xmlns:soapenv=""http://schemas.xmlsoap.org/soap/envelope/"" xmlns:web=""http://webservice.web.integracao.sascar.com.br/"">
           <soapenv:Header/>
           <soapenv:Body>
              <web:obterPacotePosicaoMotoristaHistorico>
                 <usuario>{0}</usuario>
                 <senha>{1}</senha>
                 <dataInicio>{2}</dataInicio>
                 <dataFinal>{3}</dataFinal>
                 <idVeiculo>{4}</idVeiculo>
              </web:obterPacotePosicaoMotoristaHistorico>
           </soapenv:Body>
        </soapenv:Envelope>", "INTERNATRANSLUTE", "sascar", dataInicio, dataFim, vehicleId); // <-- CREDENCIAIS PREENCHIDAS AQUI

        try
        {
            HttpWebRequest request = (HttpWebRequest)WebRequest.Create(url);
            request.Method = "POST";
            request.ContentType = "text/xml;charset=UTF-8";
            byte[] bytes = System.Text.Encoding.UTF8.GetBytes(soapRequestXml);
            request.ContentLength = bytes.Length;

            using (Stream requestStream = request.GetRequestStream())
            {
                requestStream.Write(bytes, 0, bytes.Length);
            }

            using (HttpWebResponse response = (HttpWebResponse)request.GetResponse())
            {
                using (StreamReader reader = new StreamReader(response.GetResponseStream()))
                {
                    string soapResponseXml = reader.ReadToEnd();
                    XmlDocument xmlDoc = new XmlDocument();
                    xmlDoc.LoadXml(soapResponseXml);

                    XmlNamespaceManager nsManager = new XmlNamespaceManager(xmlDoc.NameTable);
                    nsManager.AddNamespace("ns0", "http://webservice.web.integracao.sascar.com.br/");

                    XmlNodeList returnNodes = xmlDoc.SelectNodes("//ns0:obterPacotePosicaoMotoristaHistoricoResponse/return", nsManager);

                    XmlNode maisRecenteNode = null;
                    DateTime maisRecenteData = DateTime.MinValue;

                    // Itera nos resultados para encontrar o mais recente
                    foreach (XmlNode positionNode in returnNodes)
                    {
                        DateTime dataAtual = GetNodeDateTime(positionNode, "dataPacote");
                        if (dataAtual > maisRecenteData)
                        {
                            maisRecenteData = dataAtual;
                            maisRecenteNode = positionNode;
                        }
                    }

                    // Se encontrou um registro, adiciona ao fluxo
                    if (maisRecenteNode != null)
                    {
                        SaidaUltimaPosicaoBuffer.AddRow();
                        SaidaUltimaPosicaoBuffer.placa = Variables.CurrentPlaca;
                        SaidaUltimaPosicaoBuffer.idVeiculo = GetNodeInt(maisRecenteNode, "idVeiculo");
                        SaidaUltimaPosicaoBuffer.idMotorista = GetNodeInt(maisRecenteNode, "idMotorista");
                        SaidaUltimaPosicaoBuffer.nomeMotorista = GetNodeText(maisRecenteNode, "nomeMotorista");
                        SaidaUltimaPosicaoBuffer.latitude = GetNodeDouble(maisRecenteNode, "latitude");
                        SaidaUltimaPosicaoBuffer.longitude = GetNodeDouble(maisRecenteNode, "longitude");
                        SaidaUltimaPosicaoBuffer.dataPacote = GetNodeDateTime(maisRecenteNode, "dataPacote");
                        SaidaUltimaPosicaoBuffer.velocidade = GetNodeInt(maisRecenteNode, "velocidade");
                        SaidaUltimaPosicaoBuffer.ignicao = GetNodeInt(maisRecenteNode, "ignicao");
                        SaidaUltimaPosicaoBuffer.odometro = GetNodeInt(maisRecenteNode, "odometro");
                    }
                }
            }
        }
        catch (WebException ex)
        {
            // Opcional: Tratar erros para n�o parar o loop inteiro se um ve�culo falhar
            // Para depura��o, � bom deixar o erro acontecer. Para produ��o, pode-se apenas registrar o erro.
            bool fireError = true;
            string errorMessage = String.Format("Erro ao buscar dados para o ve�culo ID {0}: {1}", vehicleId, ex.Message);
            if (ex.Response != null)
            {
                using (StreamReader sr = new StreamReader(ex.Response.GetResponseStream()))
                {
                    errorMessage += " | Detalhe: " + sr.ReadToEnd();
                }
            }
            ComponentMetaData.FireError(0, "Script Component API Call", errorMessage, "", 0, out fireError);
        }
    }

    #region Fun��es Auxiliares (Cole esta parte tamb�m)
    private string GetNodeText(XmlNode parentNode, string nodeName)
    {
        XmlNode node = parentNode.SelectSingleNode(nodeName);
        return node != null ? node.InnerText : string.Empty;
    }

    private int GetNodeInt(XmlNode parentNode, string nodeName)
    {
        XmlNode node = parentNode.SelectSingleNode(nodeName);
        if (node != null && int.TryParse(node.InnerText, out int result))
        {
            return result;
        }
        return 0;
    }

    private double GetNodeDouble(XmlNode parentNode, string nodeName)
    {
        XmlNode node = parentNode.SelectSingleNode(nodeName);
        if (node != null && double.TryParse(node.InnerText, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double result))
        {
            return result;
        }
        return 0.0;
    }

    private DateTime GetNodeDateTime(XmlNode parentNode, string nodeName)
    {
        XmlNode node = parentNode.SelectSingleNode(nodeName);
        if (node != null && DateTime.TryParse(node.InnerText, out DateTime result))
        {
            return result;
        }
        return DateTime.MinValue;
    }
    #endregion
}]]></arrayElement>
