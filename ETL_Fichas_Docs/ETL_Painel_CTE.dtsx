              <outputs>
                <output
                  refId="Package\Load fCTE\ADO NET Destination.Outputs[ADO NET Destination Error Output]"
                  exclusionGroup="1"
                  isErrorOut="true"
                  name="ADO NET Destination Error Output"
                  synchronousInputId="Package\Load fCTE\ADO NET Destination.Inputs[ADO NET Destination Input]">
