              <outputs>
                <output
                  refId="Package\Load fBaseSequencias\ADO NET Destination.Outputs[ADO NET Destination Error Output]"
                  exclusionGroup="1"
                  isErrorOut="true"
                  name="ADO NET Destination Error Output"
                  synchronousInputId="Package\Load fBaseSequencias\ADO NET Destination.Inputs[ADO NET Destination Input]">
                  <outputColumns>
                    <outputColumn
                      refId="Package\Load fBaseSequencias\ADO NET Destination.Outputs[ADO NET Destination Error Output].Columns[ErrorCode]"
